rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn()
        && request.auth.token.email == "alimiranerr@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function approved() {
      return admin() || (signedIn() && request.auth.token.email_verified == true && userDoc().status == "approved");
    }

    match /bugReports/{reportId} {
      allow read: if admin() || (signedIn() && request.auth.token.email_verified == true && approved() && resource.data.status == "published");
      allow create, update, delete: if false;
    }

    // H.E.L.P.Y quota data is server-managed; users may only read their own quota.
    match /helpyQuotas/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if false;
    }

    // Quota requests can only be created/reviewed by trusted callable functions.
    match /helpyQuotaRequests/{requestId} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /helpyQuotaRequestLocks/{uid} {
      allow read, write: if false;
    }

    match /errorCodes/{codeId} {
      allow read: if approved();
      allow create, update, delete: if admin();
    }

    match /sites/{siteId} {
      allow read: if resource.data.active == true || admin();
      allow create, update, delete: if admin();
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending";
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow update, delete: if admin();
    }

    match /tickets/{ticketId} {
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "open";
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["attachmentPath","attachmentType","updatedAt"])
        && request.resource.data.attachmentPath.matches("supportMedia/" + request.auth.uid + "/" + ticketId + "/[a-f0-9-]{36}\\.(jpg|png|gif|webp)")
        && request.resource.data.attachmentType in ["image/png","image/jpeg","image/gif","image/webp"]);
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["updatedAt"])
      );
      allow delete: if false;

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if signedIn() && (parentChat().uid == request.auth.uid || admin());
        allow create: if approved()
          && (parentChat().uid == request.auth.uid || admin())
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // helpyThrottle is server-managed only; clients cannot read or modify it.
    // All other paths are denied by default.

    // AquaWorld public player cards and private cloud saves.
    match /aquaPlayers/{uid} {
      allow read: if signedIn() && request.auth.token.email_verified == true && (request.auth.uid == uid || resource.data.visibility == "public");
      allow create: if signedIn() && request.auth.token.email_verified == true && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.visibility == "public";
      allow update: if signedIn() && request.auth.token.email_verified == true && request.auth.uid == uid && request.resource.data.uid == uid;
      allow delete: if false;
    }
    match /aquaPrivate/{uid} {
      allow read: if signedIn() && request.auth.token.email_verified == true && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.token.email_verified == true && request.auth.uid == uid && request.resource.data.uid == uid;
      allow delete: if false;
    }
    // HAKO public community forum. Reading is public; writing requires an approved support account.
    match /forumTopics/{topicId} {
      allow read: if true;
      allow create: if approved()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 20
        && request.resource.data.body.size() <= 5000
        && request.resource.data.category is string
        && request.resource.data.category in ["Genel Sohbet", "OCTOPUS AquaWorld", "Matematik Macerası", "Teknik Destek", "Fikir ve Öneriler", "Duyurular"];
      allow update: if admin();
      allow delete: if admin();
      match /replies/{replyId} {
        allow read: if true;
        allow create: if approved()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 2
          && request.resource.data.body.size() <= 2500;
        allow update, delete: if admin();
      }
    }

    match /aquaCoinTransfers/{transferId} {
      allow read: if signedIn() && request.auth.token.email_verified == true
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }
    match /aquaCoinTransferRateLimits/{uid} {
      allow read, write: if false;
    }

    match /aquaWorldReports/{reportId} {
      allow read: if admin();
      allow write: if false;
    }
  }
}
